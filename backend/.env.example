# Bo_Check Backend Environment Variables

# App Settings
APP_NAME=Bo_Check API
APP_VERSION=0.1.0
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bo_check

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=1800

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Scraping
SCRAPE_DELAY=2.0

# API
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
